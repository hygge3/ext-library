<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <groupId>ext.library</groupId>
    <artifactId>ext-bom</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>ext-bom</name>
    <description>Ext Library BOM - 依赖版本统一管理</description>

    <properties>
        <!-- 第三方依赖版本 -->
        <mapstruct-plus.version>1.5.0</mapstruct-plus.version>
        <swagger.version>2.2.42</swagger.version>
        <bcprov.version>1.83</bcprov.version>
        <oshi.version>6.9.3</oshi.version>
        <springdoc.version>3.0.1</springdoc.version>
        <zxing-core.version>3.5.4</zxing-core.version>
        <therapi-javadoc.version>0.15.0</therapi-javadoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ======================= 第三方依赖 ===================== -->
            <!-- mapstruct-plus -->
            <dependency>
                <groupId>io.github.linpeilie</groupId>
                <artifactId>mapstruct-plus-spring-boot-starter</artifactId>
                <version>${mapstruct-plus.version}</version>
            </dependency>
            <!-- bouncy castle -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bcprov.version}</version>
            </dependency>
            <!-- swagger-annotations -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations</artifactId>
                <version>${swagger.version}</version>
            </dependency>
            <!-- therapi-runtime-javadoc -->
            <dependency>
                <groupId>com.github.therapi</groupId>
                <artifactId>therapi-runtime-javadoc</artifactId>
                <version>${therapi-javadoc.version}</version>
            </dependency>
            <!-- oshi -->
            <dependency>
                <groupId>com.github.oshi</groupId>
                <artifactId>oshi-core-java25</artifactId>
                <version>${oshi.version}</version>
            </dependency>
            <!-- springdoc -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- google zxing -->
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>javase</artifactId>
                <version>${zxing-core.version}</version>
            </dependency>

            <!-- ======================= ext-common 层 ===================== -->
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-tool</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-json</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ======================= ext-infra 层 ===================== -->
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-redis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-cache</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-mail</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-postgres</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ======================= 安全/加密层 ===================== -->
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-crypto</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ======================= ext-web 层 ===================== -->
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-mvc</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-openapi</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-sse</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-websocket</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ======================= ext-enhance 层 ===================== -->
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-captcha</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-idempotent</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-desensitize</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-trans</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-api-crypto</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ======================= ext-misc 层 ===================== -->
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-http</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-qrcode</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-monitor</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-holidays</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>

    </build>
</project>
