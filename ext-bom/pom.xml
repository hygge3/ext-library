<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <groupId>ext.library</groupId>
    <artifactId>ext-bom</artifactId>
    <version>4.0.0</version>
    <packaging>pom</packaging>
    <name>ext-bom</name>
    <description>Ext Library BOM - 依赖版本统一管理</description>

    <properties>
        <revision>4.0.0</revision>
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ======================= ext-common 层 ===================== -->
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-tool</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-json</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ======================= ext-infra 层 ===================== -->
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-redis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-cache</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-mail</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-postgres</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ======================= 安全/加密层 ===================== -->
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-crypto</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ======================= ext-web 层 ===================== -->
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-mvc</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-openapi</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-sse</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-websocket</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ======================= ext-enhance 层 ===================== -->
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-captcha</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-idempotent</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-desensitize</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-trans</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-api-crypto</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ======================= ext-misc 层 ===================== -->
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-http</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-qrcode</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-monitor</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ext.library</groupId>
                <artifactId>ext-holidays</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>${maven-clean-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>${maven-install-plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
